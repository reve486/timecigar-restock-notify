{
  "name": "timecigar-restock-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timecigar-restock",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://reve486.github.io"
  }
}
